# === NETO — Variables de entorno ===
# Copiar este archivo como .env y completar los valores

# --- Entorno ---
NODE_ENV=development
PORT=3000

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key

# --- Meta / WhatsApp ---
META_ACCESS_TOKEN=your-meta-token
META_PHONE_NUMBER_ID=your-phone-id
META_VERIFY_TOKEN=your-verify-token
META_APP_SECRET=your-meta-app-secret

# --- Google OAuth (Gmail) ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# --- Railway / URLs ---
RAILWAY_URL=https://api.neto.pe

# --- Admin ---
ADMIN_KEY=your-admin-secret-key
ADMIN_WHATSAPP=51970398192
WA_PHONE_NUMBER=51933014505

# --- Telegram (notificaciones admin + aprobación de pagos con botones inline) ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ADMIN_CHAT_ID=your-admin-chat-id
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret
PUBLIC_BACKEND_URL=https://api.neto.pe

# --- Interno (webapp app.neto.pe → backend, upgrade Pro). Mismo valor en Vercel. ---
INTERNAL_API_KEY=your-internal-service-key

# --- Huella del correo de Gmail que sobrevive al borrado de cuenta (migración 073) ---
# HMAC de `gmail_cuentas.email_hash`. Vive SOLO acá y nunca en la DB: es lo que hace que un
# dump de Postgres —o un backup de R2, que se guarda 365 días— no alcance para revertirlo.
#
# Si falta, nada se rompe pero el sistema se degrada en la dirección segura: el gate del canje
# de OAuth cae a comparar el correo en claro (el comportamiento anterior a la 073) y el borrado
# de cuenta CONSERVA el correo en vez de borrarlo, para no perder un cupo de Google que no se
# recupera nunca. El admin recibe el aviso cada vez que eso pasa.
#
# NO lo rotes sin backfillear `email_hash`: los hashes viejos dejan de coincidir y quien
# reconecte su mismo correo va a pasar por el fallback del correo en claro.
GMAIL_EMAIL_HASH_PEPPER=genera-uno-con-openssl-rand-base64-32

# --- Link de activación (WhatsApp → webapp). MISMO valor en Railway y en Vercel. ---
# El backend firma el token con este secreto y la webapp lo verifica sin hop de red.
# Si los dos lados no coinciden, TODOS los links de activación mueren en silencio
# (el usuario cae en un login normal). Lo cubre qa-e2e/qa-activacion-link.mjs.
ACTIVATION_TOKEN_SECRET=your-activation-token-secret

# --- Opcionales ---
SCAN_INTERVAL_HOURS=0.25
LOG_LEVEL=info

# --- Backup ---
# El backup NO corre en el backend. Corre a diario en GitHub Actions
# (.github/workflows/backup-db.yml) y sus credenciales viven en los secrets
# del repo, no aca. Para restaurar o probar en local, ver
# docs/runbook-restore.md y ~/.config/neto/backup.env
